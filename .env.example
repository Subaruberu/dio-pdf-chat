# Copie para .env e preencha se quiser respostas geradas pela OpenAI.
# Sem chave, o projeto roda 100% local (embeddings locais + respostas extrativas).

OPENAI_API_KEY=
# OPENAI_BASE_URL=          # opcional: proxy ou endpoint compatível

PDFCHAT_LLM_MODEL=gpt-4o-mini
PDFCHAT_EMBED_MODEL=text-embedding-3-small
PDFCHAT_TEMPERATURE=0.2

# auto = usa OpenAI se houver chave; openai = exige chave; local = força offline
PDFCHAT_BACKEND=auto
# PDFCHAT_LLM_BACKEND=auto
# PDFCHAT_EMBED_BACKEND=auto

PDFCHAT_RETRIEVAL=hybrid
PDFCHAT_TOP_K=5
PDFCHAT_CHUNK_SIZE=900
PDFCHAT_CHUNK_OVERLAP=150
PDFCHAT_EMBEDDING_DIM=1024

# Se a API falhar, responde em modo local em vez de quebrar o chat
PDFCHAT_FALLBACK=1

# PDFCHAT_INDEX_DIR=data/index
# PDFCHAT_INPUTS_DIR=inputs
